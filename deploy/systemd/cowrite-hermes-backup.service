[Unit]
Description=Create and verify a Cowrite Hermes backup
After=cowrite-hermes.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/opt/cowrite-hermes/deploy/scripts/cowrite-hermes-backup
TimeoutStartSec=30min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
